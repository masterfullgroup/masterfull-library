{
  "name": "masterfull-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "admin:check": "node scripts/check-admin.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test:covers-local": "node --test tests/local-cover-storage.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-masterfull-library-rules --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:drive": "node --test tests/google-drive.test.mjs",
    "test:books": "node --test tests/book-cover.test.mjs",
    "test:google-books": "node --test tests/google-books.test.mjs",
    "check:pages-env": "node scripts/validate-pages-env.mjs"
  },
  "dependencies": {
    "caniuse-lite": "1.0.30001816",
    "firebase": "^13.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  },
  "overrides": {
    "caniuse-lite": "1.0.30001816"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true
  }
}
